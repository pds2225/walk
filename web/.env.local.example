# web/.env.local 의 예시 — 이 파일을 .env.local 로 복사해 값을 채운다.
# .env.local 은 .gitignore 에 있어 커밋되지 않는다. 값을 여기(example)에 적지 말 것.
#
# REST/TMAP/NAVER 키는 서버(API 라우트)에서만 읽는다. NEXT_PUBLIC_ 접두어를
# 붙이지 않는다. Roadview JavaScript 키는 브라우저 SDK가 요구하므로 아래 항목만
# 예외이며, Kakao Developers의 허용 도메인 제한을 함께 설정한다.

# 도보 경로 탐색 + 주소·장소 검색. 없으면 앱이 동작하지 않는다.
# https://openapi.sk.com/ → My Project → TMAP API
TMAP_APP_KEY=

# 가게·상호 이름 검색("○○치킨"). 카카오 developers → 내 애플리케이션 → 앱 키.
# 반드시 REST API 키 — JavaScript 키·네이티브 앱 키는 401 이 난다.
KAKAO_REST_API_KEY=

# 목적지 근처 Kakao Roadview 브라우저 SDK. REST API 키와 다르다.
NEXT_PUBLIC_KAKAO_JAVASCRIPT_KEY=

# NAVER 거리뷰(파노라마) 브라우저 SDK. 상호검색용 NAVER_SEARCH_* 와 다른 키다.
# 네이버 클라우드 Maps Application 의 Client ID(ncpKeyId)만 넣는다.
# Client Secret 은 브라우저에 넣지 않는다.
NEXT_PUBLIC_NAVER_MAP_CLIENT_ID=

# Google Street View 브라우저 SDK. Maps JavaScript API 키. 없으면 Google provider 는 꺼진다.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Roadview provider 강제 지정(선택). kakao | naver | google
# 비우면 키가 있는 것 중 Kakao → NAVER → Google 순서로 고른다.
# Kakao 키가 있는 상태에서 네이버 거리뷰를 쓰려면 naver 로 적는다.
NEXT_PUBLIC_ROADVIEW_PROVIDER=

# Roadview 동작값(선택). 비워두면 기본값을 쓴다 — 굳이 적을 필요 없다.
# 목적지까지 남은 거리가 이 값 이하일 때 Roadview 진입을 제안한다(m). 기본 50
NEXT_PUBLIC_ROADVIEW_TRIGGER_DISTANCE_M=
# 목적지 주변 pano 를 찾을 반경을 순서대로 적는다(m, 쉼표 구분). 기본 50,30
NEXT_PUBLIC_ROADVIEW_SEARCH_RADIUS_M=

# 네이버 지역검색(선택) — 카카오와 같은 자리를 메운다. 둘 중 하나만 있어도 된다.
# developers.naver.com 의 '검색' 애플리케이션 키이며, 네이버 클라우드(지도) 키와 다르다.
NAVER_SEARCH_CLIENT_ID=
NAVER_SEARCH_CLIENT_SECRET=
